---
// 1. Interface TypeScript untuk validasi props/data
export interface PreweddingPackageItem {
  id: string;
  name: string;
  duration: string;
  price: string;
  isPopular?: boolean;
  isVIP?: boolean;
  tagline?: string;
  features: string[];
}

export interface Props {
  title?: string;
  subtitle?: string;
  packages?: PreweddingPackageItem[];
}

// 2. Data Default
const defaultPackages: PreweddingPackageItem[] = [
  {
    id: "prewedding-basic",
    name: "Prewedding Basic",
    duration: "2 Jam",
    price: "2.500.000",
    features: [
      "Penggunaan Pendopo Taman SSKI, area taman, & pendopo",
      "Dekorasi & properti foto standar",
      "Sound system & Fotografer",
      "50–75 foto digital",
      "10 foto editing"
    ]
  },
  {
    id: "prewedding-traditional-bali",
    name: "Prewedding Traditional Bali",
    duration: "1–2 Jam",
    price: "4.500.000",
    isPopular: true,
    features: [
      "Venue Pendopo Taman SSKI & dekorasi bernuansa Bali",
      "Kostum tradisional Bali & aksesori pendukung",
      "Tata rias sederhana & Fotografer profesional",
      "100 foto digital & 20 foto editing",
      "Dokumentasi video pendek / Reels",
      "Sound system"
    ]
  },
  {
    id: "prewedding-exclusive",
    name: "Prewedding Exclusive",
    duration: "2–3 Jam",
    price: "7.500.000",
    isVIP: true,
    tagline: "Paket paling lengkap untuk momen spesial dengan hasil sinematik berkelas.",
    features: [
      "Eksklusivitas venue (Pendopo & Taman SSKI)",
      "Konsep dekorasi khusus & Balinese traditional setup",
      "Kostum, aksesori, Make-up, & Hairdo lengkap",
      "Fotografer & Videografer profesional",
      "150–200 foto digital & 30 foto editing",
      "Video cinematic 1–3 menit & Sound system"
    ]
  }
];

// 3. Destrukturisasi Props
const {
  title = "PAKET FOTO PREWEDDING",
  subtitle = "Abadikan momen romantis Anda dengan latar budaya dan keindahan Pendopo Taman SSKI",
  packages = defaultPackages
} = Astro.props;
---

<!-- Main Section dengan Background Gelap Senada & Scroll Margin Navbar -->
<section id="paket-foto-prewedding" class="relative w-full bg-[#050505] text-white px-6 py-20 scroll-mt-20 overflow-hidden">
  <div class="max-w-7xl mx-auto relative z-10">
    
    <!-- Section Title -->
    <div class="text-center mb-14">
      <span class="text-rose-400 font-medium tracking-widest uppercase text-xs sm:text-sm">Wedding Photography</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mt-2 mb-3 uppercase">
        {title}
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Grid Render Loop (.map) dengan Strict Type Annotation -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
      {packages.map((pkg: PreweddingPackageItem) => (
        <article
          id={pkg.id}
          class={`rounded-3xl transition-all overflow-hidden flex flex-col justify-between relative p-8 border ${
            pkg.isVIP
              ? "bg-zinc-900 border-amber-500/50 shadow-[0_0_30px_rgba(245,158,11,0.15)] ring-1 ring-amber-500/50"
              : pkg.isPopular
              ? "bg-zinc-900/90 border-rose-500/50 shadow-[0_0_30px_rgba(244,63,94,0.15)] ring-1 ring-rose-500/50"
              : "bg-zinc-900/40 border-white/10 hover:border-white/20 hover:bg-zinc-900/60"
          }`}
        >
          <!-- Badge Populer / VIP -->
          {pkg.isPopular && (
            <div class="absolute top-0 right-0 bg-rose-600 text-white text-[10px] uppercase tracking-wider font-bold px-4 py-1.5 rounded-bl-2xl shadow-md">
              Paling Populer
            </div>
          )}
          {pkg.isVIP && (
            <div class="absolute top-0 right-0 bg-amber-500 text-slate-950 text-[10px] uppercase tracking-wider font-bold px-4 py-1.5 rounded-bl-2xl shadow-md">
              Luxury VIP
            </div>
          )}

          <div>
            <!-- Header Card -->
            <div class="mb-6">
              <span
                class={`inline-block text-xs font-semibold px-3 py-1 rounded-full mb-4 ${
                  pkg.isVIP
                    ? "bg-amber-500/20 text-amber-300 border border-amber-500/30"
                    : "bg-rose-500/20 text-rose-300 border border-rose-500/30"
                }`}
              >
                Durasi: {pkg.duration}
              </span>
              <h3 class="text-2xl font-bold text-white mb-2">
                {pkg.name}
              </h3>
            </div>

            <!-- Tagline jika VIP -->
            {pkg.tagline && (
              <p class="text-amber-200/80 text-xs italic mb-6 bg-amber-500/10 p-3 rounded-xl border border-amber-500/20 leading-relaxed">
                {pkg.tagline}
              </p>
            )}

            <!-- Harga -->
            <div
              class={`flex items-baseline gap-1.5 my-6 p-4 rounded-2xl border ${
                pkg.isVIP
                  ? "bg-amber-950/30 border-amber-500/30"
                  : pkg.isPopular
                  ? "bg-rose-950/40 border-rose-500/30"
                  : "bg-black/40 border-white/5"
              }`}
            >
              <span class={`text-sm font-medium ${pkg.isVIP ? "text-amber-400" : "text-rose-400"}`}>
                Rp
              </span>
              <span class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
                {pkg.price}
              </span>
            </div>

            <!-- Fasilitas List -->
            <div class="border-t border-white/10 pt-6">
              <h4 class={`text-xs font-bold uppercase tracking-wider mb-4 ${pkg.isVIP ? "text-amber-400" : "text-zinc-400"}`}>
                Fasilitas Termasuk:
              </h4>
              <ul class="space-y-3 text-sm text-zinc-300">
                {pkg.features.map((feature: string) => (
                  <li class="flex items-start gap-3">
                    <svg
                      class={`w-5 h-5 shrink-0 mt-0.5 ${pkg.isVIP ? "text-amber-400" : "text-rose-400"}`}
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="leading-snug">{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <!-- Action Button -->
          <div class="pt-8">
            <a
              href="#kontakt"
              class={`w-full block text-center font-semibold py-3.5 px-4 rounded-xl transition-all duration-300 ${
                pkg.isVIP
                  ? "bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold shadow-[0_0_20px_rgba(245,158,11,0.3)]"
                  : pkg.isPopular
                  ? "bg-white text-black hover:bg-zinc-200 shadow-[0_0_20px_rgba(255,255,255,0.2)]"
                  : "bg-white/10 hover:bg-white/20 text-white border border-white/10"
              }`}
            >
              Pesan Paket Prewedding
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>

  <!-- Background Glow Effects (Konsisten) -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute top-1/3 left-10 w-96 h-96 bg-rose-900/10 rounded-full blur-[140px]"></div>
    <div class="absolute bottom-10 right-10 w-96 h-96 bg-amber-900/10 rounded-full blur-[140px]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-size-[4rem_4rem] mask-[radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)]"></div>
  </div>
</section>