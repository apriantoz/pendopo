---
// 1. Interface TypeScript untuk Props
export interface Props {
  title?: string;
  subtitle?: string;
  whatsappNumber?: string; // Format: 628xxxxxxxxxx
  defaultMessage?: string;
}

// 2. Destrukturisasi Props dengan Nilai Default
const {
  title = "Wujudkan Acara Impian Anda di Pendopo Taman SSKI",
  subtitle = "Punya pertanyaan seputar ketersediaan jadwal, kustomisasi dekorasi, atau kolaborasi seni? Tim kami siap mendengarkan dan membantu merencanakan setiap detail momen spesial Anda.",
  whatsappNumber = "628124602907", // <--- Ganti dengan nomor WhatsApp aktif
  defaultMessage = "Halo Pendopo Taman SSKI, saya ingin berkonsultasi mengenai rencana acara dan ketersediaan venue.",
} = Astro.props;

const encodedMessage = encodeURIComponent(defaultMessage);
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodedMessage}`;
---

{/*Main Section Hubungi Kami */}
<section
  id="kontakt"
  class="relative w-full bg-[#050505] text-white py-24 px-6 scroll-mt-20 overflow-hidden font-sans"
>
  <div class="max-w-6xl mx-auto relative z-10">
    {/* Wrapper Utama dengan Grid Asimetris Elegan */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      {/* Sisi Kiri: Judul & Narasi Informatif */}
      <div class="lg:col-span-7 space-y-6">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-zinc-300 text-xs tracking-wider uppercase"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"
          ></span>
          Hubungi Kami
        </div>

        <h2
          class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight uppercase leading-[1.15]"
        >
          {title}
        </h2>

        <p class="text-zinc-400 text-base sm:text-lg leading-relaxed">
          {subtitle}
        </p>

        {/* Poin Keunggulan Respon Cepat */}
        <div
          class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-white/10"
        >
          <div class="flex items-start gap-3">
            <div
              class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0 mt-1"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 13l4 4L19 7"></path></svg
              >
            </div>
            <div>
              <h4 class="text-sm font-bold text-white">Respon Cepat</h4>
              <p class="text-xs text-zinc-400 mt-0.5">
                Balasan langsung dari tim operasional kami.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div
              class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 shrink-0 mt-1"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M5 13l4 4L19 7"></path></svg
              >
            </div>
            <div>
              <h4 class="text-sm font-bold text-white">Konsultasi Gratis</h4>
              <p class="text-xs text-zinc-400 mt-0.5">
                Diskusi konsep acara tanpa biaya tersembunyi.
              </p>
            </div>
          </div>
        </div>
      </div>

      {/* Sisi Kanan: Kartu Aksi WhatsApp + Validasi Captcha */}
      <div class="lg:col-span-5">
        <div
          class="bg-gradient-to-br from-zinc-900/90 to-zinc-950 border border-white/10 rounded-3xl p-8 sm:p-10 shadow-2xl relative overflow-hidden group"
        >
          {/* Hiasan Glow Halus di dalam Card */}
          <div
            class="absolute -top-24 -right-24 w-48 h-48 bg-emerald-500/10 rounded-full blur-3xl group-hover:bg-emerald-500/20 transition-all"
          >
          </div>

          <div class="relative z-10 space-y-6">
            <div>
              <span
                class="text-xs font-semibold text-emerald-400 uppercase tracking-widest"
                >Verifikasi Keamanan</span
              >
              <h3 class="text-2xl font-bold text-white mt-1">
                Mulai Percakapan
              </h3>
              <p class="text-xs text-zinc-400 mt-1">
                Jawab pertanyaan matematika di bawah untuk membuka tautan
                WhatsApp.
              </p>
            </div>

            {/* Bagian Captcha & Tombol */}
            <div class="space-y-4 pt-2">
              <div
                class="bg-white/5 border border-white/10 rounded-2xl p-4 flex items-center justify-between gap-3"
              >
                <span
                  id="math-question"
                  class="text-sm font-medium text-zinc-300">Memuat soal...</span
                >
                <input
                  type="number"
                  id="captcha-input"
                  placeholder="Jawaban"
                  autocomplete="off"
                  class="w-25 bg-black/40 border border-white/15 rounded-xl px-3 py-2 text-center text-white text-sm focus:outline-none focus:border-emerald-500 transition-colors"
                />
              </div>
              <p id="error-msg" class="text-xs text-red-400 hidden text-center">
                Jawaban salah, silakan coba lagi.
              </p>

              {/* Tombol WA (Berfungsi setelah captcha benar) */}
              <button
                id="verify-btn"
                type="button"
                class="w-full inline-flex items-center justify-center gap-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-4 px-6 rounded-2xl transition-all duration-300 shadow-[0_4px_20px_rgba(16,185,129,0.3)] hover:scale-[1.02] cursor-pointer"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path
                    d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
                  ></path>
                </svg>
                <span>Hubungi via WhatsApp</span>
              </button>
            </div>

            {/* {Jam Operasional Info} */}
            <div class="pt-4 border-t border-white/10 text-center">
              <span class="text-xs text-zinc-500"
                >Senin – Minggu • 09.00 – 18.00 WITA</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Background Glow & Grid Effects Konsisten */}
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div
      class="absolute bottom-0 right-1/4 w-96 h-96 bg-emerald-950/10 rounded-full blur-[140px]"
    >
    </div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-size-[4rem_4rem] mask-[radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)]"
    >
    </div>
  </div>
</section>

{/* Skrip Client-Side untuk Validasi Captcha */}
<script define:vars={{ whatsappUrl }}>
  // Membuat angka acak antara 1 sampai 9
  const num1 = Math.floor(Math.random() * 9) + 1;
  const num2 = Math.floor(Math.random() * 9) + 1;
  const correctAnswer = num1 + num2;

  const questionEl = document.getElementById("math-question");
  const inputEl = document.getElementById("captcha-input");
  const btnEl = document.getElementById("verify-btn");
  const errorEl = document.getElementById("error-msg");

  // Menampilkan pertanyaan ke elemen HTML
  if (questionEl) {
    questionEl.textContent = `${num1} + ${num2} ?`;
  }

  // Fungsi saat tombol diklik
  btnEl?.addEventListener("click", () => {
    const userAnswer = parseInt(inputEl?.value.trim() || "0", 10);

    if (userAnswer === correctAnswer) {
      errorEl?.classList.add("hidden");
      // Membuka WhatsApp di tab baru
      window.open(whatsappUrl, "_blank");
      // Reset input setelah berhasil
      if (inputEl) inputEl.value = "";
    } else {
      errorEl?.classList.remove("hidden");
      inputEl?.focus();
    }
  });

  // Mendukung tombol "Enter" pada keyboard
  inputEl?.addEventListener("keypress", (e) => {
    if (e.key === "Enter") {
      btnEl?.click();
    }
  });
</script>
