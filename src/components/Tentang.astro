---
const {
  title = "Tentang Kami",
  content = "Pendopo Taman SSKI adalah ruang terbuka yang menggabungkan keindahan seni dan budaya Bali. Kami menyediakan berbagai program workshop seni, pelatihan sanggar tari dan gamelan, serta penyediaan tempat untuk berbagai momentum istimewa.",
  imageSrc = "/images/hero-bg-3.jpg", // Ganti dengan path gambar yang sesuai
} = Astro.props;
---

<section
  id="tentang-kami"
  class="relative w-full bg-[#050505] text-white px-6 py-20 scroll-mt-20"
>
  <div class="max-w-6xl mx-auto">
    {/* {Wrapper Card Besar dengan Background Gambar} */}
    <div
      class="relative rounded-3xl overflow-hidden border border-white/10 shadow-2xl min-h-125 flex items-center p-8 sm:p-12 md:p-16 group"
    >
      {/* Gambar Latar dengan efek zoom halus saat hover card */}
      <img
        src={imageSrc}
        alt="Pendopo Taman SSKI"
        class="absolute inset-0 w-full h-full object-cover filter brightness-75 transform group-hover:scale-105 transition-transform duration-700"
      />

      {/* Overlay Gelap Gradasi (Biar teks tetap kontras dan terbaca jelas) */}
      <div
        class="absolute inset-0 bg-linear-to-r from-black/90 via-black/70 to-black/30"
      >
      </div>

      {/* Konten Teks & Tombol */}
      <div class="relative z-10 max-w-2xl flex flex-col items-start text-left">
        <h2
          class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-white leading-[1.1] mb-6"
        >
          {title}
        </h2>
        <p
          class="text-sm sm:text-base text-zinc-300 font-normal leading-relaxed tracking-wide mb-8"
        >
          {content}
        </p>
        <a
          href="#paket-sewa-tempat"
          class="px-8 py-4 rounded-xl bg-white text-black font-semibold hover:bg-zinc-200 transition-all duration-300 shadow-lg text-center"
        >
          Lihat Layanan Kami
        </a>
      </div>
    </div>
  </div>
</section>
