---
// 1. Interface TypeScript untuk validasi props/data
export interface WeddingPackageItem {
  id: string;
  name: string;
  capacity: string;
  price: string;
  unit?: string;
  isPopular?: boolean;
  isGrand?: boolean;
  features: string[];
  note?: string;
}

export interface Props {
  title?: string;
  subtitle?: string;
  packages?: WeddingPackageItem[];
}

// 2. Data Default
const defaultPackages: WeddingPackageItem[] = [
  {
    id: "venue-wedding",
    name: "Venue Wedding",
    capacity: "Kapasitas 50–100 Orang",
    price: "5.000.000",
    unit: "mulai",
    features: [
      "Penggunaan Pendopo Taman SSKI & Area taman",
      "Meja dan kursi",
      "Sound system standar & Dekorasi dasar",
      "Area penerima tamu & Area foto",
      "Listrik dan fasilitas pendukung"
    ]
  },
  {
    id: "intimate-balinese-wedding",
    name: "Intimate Balinese Wedding",
    capacity: "Kapasitas 50–100 Orang",
    price: "12.500.000",
    unit: "mulai",
    isPopular: true,
    features: [
      "Venue Pendopo Taman SSKI",
      "Dekorasi Bali & Pelaminan",
      "Meja, kursi, & Sound system",
      "Dokumentasi foto (100 digital + 20 editing)",
      "Area foto pengantin & Welcome drink",
      "Koordinasi acara"
    ]
  },
  {
    id: "traditional-balinese-wedding-experience",
    name: "Traditional Balinese Wedding Experience",
    capacity: "Kapasitas 100–200 Orang",
    price: "20.000.000 – 35.000.000",
    unit: "mulai",
    isGrand: true,
    note: "Harga dapat disesuaikan dengan jumlah tamu, konsep dekorasi, dan kebutuhan upacara.",
    features: [
      "Venue eksklusif (Pendopo & Taman)",
      "Dekorasi tradisional Bali & Pelaminan mewah",
      "Sound system, Lighting, & Panggung",
      "Dokumentasi foto dan video komplit",
      "Live music / gamelan & Pengisi acara seni Bali (opsional)",
      "Area makan & Koordinasi acara"
    ]
  }
];

// 3. Destrukturisasi Props
const {
  title = "PAKET WEDDING / PERNIKAHAN",
  subtitle = "Wujudkan pernikahan impian bernuansa adat Bali yang sakral dan berkesan di Pendopo Taman SSKI",
  packages = defaultPackages
} = Astro.props;
---

{/* {Main Section dengan Background Gelap Senada & Scroll Margin Navbar} */}
<section id="paket-wedding" class="relative w-full bg-[#050505] text-white px-6 py-20 scroll-mt-20 overflow-hidden">
  <div class="max-w-7xl mx-auto relative z-10">
    
    {/* Section Title */}
    <div class="text-center mb-14">
      <span class="text-purple-400 font-medium tracking-widest uppercase text-xs sm:text-sm">Wedding Venue & Package</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mt-2 mb-3 uppercase">
        {title}
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    </div>

    {/* Grid Render Loop (.map) dengan Strict Type Annotation */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
      {packages.map((pkg: WeddingPackageItem) => (
        <article
          id={pkg.id}
          class={`rounded-3xl transition-all overflow-hidden flex flex-col justify-between relative p-8 border ${
            pkg.isGrand
              ? "bg-zinc-900 border-amber-500/50 shadow-[0_0_30px_rgba(245,158,11,0.15)] ring-1 ring-amber-500/50"
              : pkg.isPopular
              ? "bg-zinc-900/90 border-purple-500/50 shadow-[0_0_30px_rgba(168,85,247,0.15)] ring-1 ring-purple-500/50"
              : "bg-zinc-900/40 border-white/10 hover:border-white/20 hover:bg-zinc-900/60"
          }`}
        >
          <!-- Badge Populer / Grand -->
          {pkg.isPopular && (
            <div class="absolute top-0 right-0 bg-purple-600 text-white text-[10px] uppercase tracking-wider font-bold px-4 py-1.5 rounded-bl-2xl shadow-md">
              Pilihan Populer
            </div>
          )}
          {pkg.isGrand && (
            <div class="absolute top-0 right-0 bg-amber-500 text-slate-950 text-[10px] uppercase tracking-wider font-bold px-4 py-1.5 rounded-bl-2xl shadow-md">
              Grand Experience
            </div>
          )}

          <div>
            <!-- Header Card -->
            <div class="mb-6">
              <span
                class={`inline-block text-xs font-semibold px-3 py-1 rounded-full mb-4 ${
                  pkg.isGrand
                    ? "bg-amber-500/20 text-amber-300 border border-amber-500/30"
                    : "bg-purple-500/20 text-purple-300 border border-purple-500/30"
                }`}
              >
                {pkg.capacity}
              </span>
              <h3 class="text-2xl font-bold text-white mb-2">
                {pkg.name}
              </h3>
            </div>

            <!-- Harga -->
            <div
              class={`flex flex-col my-6 p-4 rounded-2xl border ${
                pkg.isGrand
                  ? "bg-amber-950/30 border-amber-500/30"
                  : pkg.isPopular
                  ? "bg-purple-950/40 border-purple-500/30"
                  : "bg-black/40 border-white/5"
              }`}
            >
              <span class={`text-xs font-semibold uppercase tracking-wider mb-1 ${pkg.isGrand ? "text-amber-400" : "text-purple-400"}`}>
                Harga {pkg.unit}:
              </span>
              <div class="flex items-baseline gap-1.5">
                <span class={`text-sm font-medium ${pkg.isGrand ? "text-amber-400" : "text-zinc-400"}`}>
                  Rp
                </span>
                <span class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
                  {pkg.price}
                </span>
              </div>
            </div>

            <!-- Fasilitas List -->
            <div class="border-t border-white/10 pt-6">
              <h4 class={`text-xs font-bold uppercase tracking-wider mb-4 ${pkg.isGrand ? "text-amber-400" : "text-zinc-400"}`}>
                Fasilitas Termasuk:
              </h4>
              <ul class="space-y-3 text-sm text-zinc-300">
                {pkg.features.map((feature: string) => (
                  <li class="flex items-start gap-3">
                    <svg
                      class={`w-5 h-5 shrink-0 mt-0.5 ${pkg.isGrand ? "text-amber-400" : "text-purple-400"}`}
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    <span class="leading-snug">{feature}</span>
                  </li>
                ))}
              </ul>

              <!-- Catatan Tambahan (jika ada) -->
              {pkg.note && (
                <p class="text-xs text-amber-300/80 italic mt-6 pt-4 border-t border-white/10 leading-relaxed">
                  * {pkg.note}
                </p>
              )}
            </div>
          </div>

          <!-- Action Button -->
          <div class="pt-8">
            <a
              href="#kontakt"
              class={`w-full block text-center font-semibold py-3.5 px-4 rounded-xl transition-all duration-300 ${
                pkg.isGrand
                  ? "bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold shadow-[0_0_20px_rgba(245,158,11,0.3)]"
                  : pkg.isPopular
                  ? "bg-white text-black hover:bg-zinc-200 shadow-[0_0_20px_rgba(255,255,255,0.2)]"
                  : "bg-white/10 hover:bg-white/20 text-white border border-white/10"
              }`}
            >
              Konsultasi / Pesan Venue
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>

  {/* Background Glow Effects (Konsisten) */}
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute top-1/2 right-10 w-96 h-96 bg-purple-900/10 rounded-full blur-[140px]"></div>
    <div class="absolute bottom-10 left-10 w-96 h-96 bg-amber-900/10 rounded-full blur-[140px]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-size-[4rem_4rem] mask-[radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)]"></div>
  </div>
</section>