---
// 1. Interface TypeScript untuk validasi props/data
export interface VenueRentalPackageItem {
  id: string;
  name: string;
  duration: string;
  price: string;
  isPopular?: boolean;
}

export interface Props {
  title?: string;
  subtitle?: string;
  venueName?: string;
  packages?: VenueRentalPackageItem[];
  standardFeatures?: string[];
}

// 2. Data Default
const defaultPackages: VenueRentalPackageItem[] = [
  {
    id: "venue-rental-4-jam",
    name: "Paket 4 Jam",
    duration: "4 Jam Durasi Sewa",
    price: "2.000.000"
  },
  {
    id: "venue-rental-8-jam",
    name: "Paket 8 Jam",
    duration: "8 Jam Durasi Sewa",
    price: "3.500.000",
    isPopular: true
  },
  {
    id: "venue-rental-full-day",
    name: "Paket Full Day",
    duration: "Penggunaan Sepanjang Hari",
    price: "5.000.000"
  }
];

const defaultStandardFeatures: string[] = [
  "Pendopo & Area taman",
  "Pasokan listrik venue",
  "Meja dan kursi standar",
  "Sound system standar",
  "Area parkir & Toilet",
  "Area persiapan / ruang ganti",
  "Area foto spot budaya"
];

// 3. Destrukturisasi Props
const {
  title = "PAKET SEWA TEMPAT SAJA",
  subtitle = "Sewa lokasi eksklusif untuk berbagai kebutuhan acara mandiri Anda",
  venueName = "Venue Rental – Pendopo Taman SSKI",
  packages = defaultPackages,
  standardFeatures = defaultStandardFeatures
} = Astro.props;
---

<!-- Main Section dengan Background Gelap Senada -->
<section id="paket-sewa-tempat" class="relative w-full bg-[#050505] text-white px-6 py-20 scroll-mt-20 overflow-hidden">
  <div class="max-w-6xl mx-auto relative z-10">
    
    <!-- Section Title -->
    <div class="text-center mb-14">
      <span class="text-indigo-400 font-medium tracking-widest uppercase text-xs sm:text-sm">Only Venue Rental</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mt-2 mb-3">
        {title}
      </h2>
      <p class="text-zinc-300 font-medium text-sm sm:text-base">
        {venueName}
      </p>
      <p class="text-zinc-400 mt-2 text-xs sm:text-sm max-w-2xl mx-auto leading-relaxed">
        {subtitle}
      </p>
    </div>

    <!-- Grid Pilihan Durasi/Harga (.map) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch mb-12">
      {packages.map((pkg: VenueRentalPackageItem) => (
        <article
          id={pkg.id}
          class={`rounded-3xl transition-all overflow-hidden flex flex-col justify-between relative p-8 border ${
            pkg.isPopular
              ? "bg-zinc-900/90 border-indigo-500/50 shadow-[0_0_30px_rgba(99,102,241,0.15)] ring-1 ring-indigo-500/50"
              : "bg-zinc-900/40 border-white/10 hover:border-white/20 hover:bg-zinc-900/60"
          }`}
        >
          <!-- Badge Populer -->
          {pkg.isPopular && (
            <div class="absolute top-0 right-0 bg-indigo-600 text-white text-[10px] uppercase tracking-wider font-bold px-4 py-1.5 rounded-bl-2xl shadow-md">
              Paling Laris
            </div>
          )}

          <div>
            <span class={`inline-block text-xs font-semibold px-3 py-1 rounded-full mb-4 ${
              pkg.isPopular ? "bg-indigo-500/20 text-indigo-300 border border-indigo-500/30" : "bg-white/10 text-zinc-300 border border-white/10"
            }`}>
              {pkg.duration}
            </span>
            <h3 class="text-2xl font-bold text-white mb-4">
              {pkg.name}
            </h3>

            <!-- Harga -->
            <div
              class={`flex items-baseline gap-1.5 my-6 p-4 rounded-2xl border ${
                pkg.isPopular ? "bg-indigo-950/40 border-indigo-500/30" : "bg-black/40 border-white/5"
              }`}
            >
              <span class={`text-sm font-medium ${pkg.isPopular ? "text-indigo-400" : "text-zinc-400"}`}>
                Rp
              </span>
              <span class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
                {pkg.price}
              </span>
            </div>
          </div>

          <!-- Action Button -->
          <div class="pt-4">
            <a
              href="#kontakt"
              class={`w-full block text-center font-semibold py-3.5 px-4 rounded-xl transition-all duration-300 ${
                pkg.isPopular
                  ? "bg-white text-black hover:bg-zinc-200 shadow-[0_0_20px_rgba(255,255,255,0.2)]"
                  : "bg-white/10 hover:bg-white/20 text-white border border-white/10"
              }`}
            >
              Pesan Durasi Ini
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Shared Standard Facilities Box -->
    <div class="bg-zinc-900/60 backdrop-blur-md text-white rounded-3xl p-6 sm:p-10 border border-white/10 shadow-2xl">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-white/10 pb-6 mb-8">
        <div>
          <h3 class="text-xl font-bold text-white">Fasilitas Standar Sewa Tempat</h3>
          <p class="text-zinc-400 text-xs sm:text-sm mt-1">Semua opsi durasi sewa di atas sudah termasuk fasilitas berikut:</p>
        </div>
        <span class="bg-indigo-500/10 text-indigo-300 border border-indigo-500/20 text-xs font-semibold px-4 py-1.5 rounded-full w-fit">
          Included All Packages
        </span>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 text-sm text-zinc-300">
        {standardFeatures.map((feature: string) => (
          <li class="flex items-center gap-3 bg-black/30 p-3.5 rounded-xl border border-white/5">
            <svg class="w-5 h-5 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span class="font-medium">{feature}</span>
          </li>
        ))}
      </ul>
    </div>

  </div>

  <!-- Background Glow Effects (Biar konsisten sama section Tentang Kami) -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute bottom-10 left-10 w-96 h-96 bg-indigo-900/15 rounded-full blur-[120px]"></div>
    <div class="absolute top-10 right-10 w-96 h-96 bg-purple-900/15 rounded-full blur-[120px]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-size-[4rem_4rem] mask-[radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)]"></div>
  </div>
</section>