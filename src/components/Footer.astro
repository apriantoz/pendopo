---
// 1. Interface TypeScript untuk Props (opsional, jika ingin dikustomisasi)
export interface Props {
  brandName?: string;
  tagline?: string;
  address?: string;
  phone?: string;
  email?: string;
  instagramUrl?: string;
  facebookUrl?: string;
  youtubeUrl?: string;
}

// 2. Destrukturisasi Props dengan Nilai Default
const {
  brandName = "Pendopo Taman SSKI",
  tagline = "Pusat seni, budaya, dan venue eksklusif berkonsep tradisional Bali di Bali.",
  phone = "+628124602907",
  email = "nyomanmariyana@gmail.com",
  instagramUrl = "https://instagram.com/sanggarsenikeboiwaa",
  facebookUrl = "https://facebook.com",
  youtubeUrl = "https://youtube.com/c/sanggarsenikeboiwa"
} = Astro.props;

const currentYear = new Date().getFullYear();
const gMaps = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("Pendopo Taman SSKI")}`;
---

<!-- Main Footer Section -->
<footer id="kontakt" class="relative w-full bg-[#030303] text-zinc-400 pt-20 pb-10 px-6 border-t border-white/10 overflow-hidden font-sans">
  <div class="max-w-7xl mx-auto relative z-10">
    
    <!-- Top Grid Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 pb-16 border-b border-white/10">
      
      <!-- Kolom 1: Brand & Tentang -->
      <div class="space-y-4 lg:col-span-1">
        <a href="#" class="inline-block text-xl font-extrabold text-white tracking-wider uppercase">
          {brandName}
        </a>
        <p class="text-sm text-zinc-400 leading-relaxed">
          {tagline}
        </p>
        <!-- Social Media Icons -->
        <div class="flex items-center gap-3 pt-2">
          <!-- Instagram -->
          <a href={instagramUrl} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-zinc-300 hover:bg-white/10 hover:text-white transition-colors" aria-label="Instagram">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <!-- Facebook -->
          <a href={facebookUrl} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-zinc-300 hover:bg-white/10 hover:text-white transition-colors" aria-label="Facebook">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <!-- YouTube -->
          <a href={youtubeUrl} target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-zinc-300 hover:bg-white/10 hover:text-white transition-colors" aria-label="YouTube">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 0 0-1.96 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.78 0 0 0 1.96 1.96C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 0 0 1.96-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02" fill="currentColor"/></svg>
          </a>
        </div>
      </div>

      <!-- Kolom 2: Navigasi Cepat (Quick Links) -->
      <div class="space-y-4">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider">Navigasi Utama</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#paket-sewa-tempat" class="hover:text-white transition-colors">Sewa Tempat</a></li>
          <li><a href="#paket-workshop-lokal" class="hover:text-white transition-colors">Workshop Wisatawan Lokal</a></li>
          <li><a href="#paket-workshop-asing" class="hover:text-white transition-colors">International Workshop</a></li>
          <li><a href="#paket-foto-prewedding" class="hover:text-white transition-colors">Foto Prewedding</a></li>
          <li><a href="#paket-wedding" class="hover:text-white transition-colors">Wedding / Pernikahan</a></li>
        </ul>
      </div>

      <!-- Kolom 3: Layanan & Acara Lainnya -->
      <div class="space-y-4">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider">Layanan Lainnya</h3>
        <ul class="space-y-2.5 text-sm">
          <li><a href="#paket-ulang-tahun" class="hover:text-white transition-colors">Perayaan Ulang Tahun</a></li>
          <li><a href="#add-on-fasilitas" class="hover:text-white transition-colors">Add-On & Fasilitas Tambahan</a></li>
          <li><a href="#tentang-kami" class="hover:text-white transition-colors">Tentang Kami</a></li>
          <li><a href="#galeri" class="hover:text-white transition-colors">Galeri Kegiatan</a></li>
        </ul>
      </div>

      <!-- Kolom 4: Informasi Kontak -->
      <div class="space-y-4">
        <h3 class="text-sm font-bold text-white uppercase tracking-wider">Hubungi Kami</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-indigo-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <a href={gMaps} target="_blank" rel="noopener noreferrer" class="text-indigo-400 hover:text-indigo-300 transition-colors text-xs block mt-1">Lihat di Google Maps</a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <a href={`tel:${phone}`} class="hover:text-white transition-colors">{phone}</a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-indigo-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <a href={`mailto:${email}`} class="hover:text-white transition-colors">{email}</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Legal -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 text-xs text-zinc-500">
      <p>&copy; {currentYear} {brandName}. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-zinc-300 transition-colors">Kebijakan Privasi</a>
        <a href="#" class="hover:text-zinc-300 transition-colors">Syarat & Ketentuan</a>
      </div>
    </div>

  </div>

  <!-- Background Glow & Grid Effects (Konsisten) -->
  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-150 h-64 bg-indigo-950/20 rounded-full blur-[140px]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-size-[4rem_4rem] mask-[radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)]"></div>
  </div>
</footer>