---
import { getCollection, type CollectionEntry } from 'astro:content';

// Ambil semua data foto dari folder src/content/galeri/
const kumpulansFoto = await getCollection('galeri');

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const fotoTampil = limit ? kumpulansFoto.slice(0, limit) : kumpulansFoto;
---

<section class="py-12 bg-gray-50 dark:bg-zinc-900">
  <div class="container mx-auto px-4">
    <!-- Header Galeri -->
    <div class="text-center mb-8">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
        Galeri Kegiatan
      </h2>
      <p class="text-gray-600 dark:text-gray-400 mt-2">
        Dokumentasi aktivitas dan karya Sanggar Seni Kebo Iwa
      </p>
    </div>

    <!-- Grid Foto Galeri -->
    {fotoTampil.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {fotoTampil.map((item: CollectionEntry<'galeri'>) => (
          <div 
            class="galeri-item group relative cursor-pointer overflow-hidden rounded-xl bg-white dark:bg-zinc-800 shadow-md transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
            data-src={item.data.image}
            data-title={item.data.title}
          >
            <!-- Container Foto -->
            <div class="aspect-video w-full overflow-hidden bg-gray-200 dark:bg-zinc-700">
              <img
                src={item.data.image}
                alt={item.data.title}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <!-- Caption / Judul Foto -->
            <div class="p-4">
              <h3 class="font-semibold text-gray-800 dark:text-gray-100 line-clamp-2">
                {item.data.title}
              </h3>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-12 text-gray-500">
        Belum ada dokumentasi foto di galeri.
      </div>
    )}
  </div>
</section>

<!-- Lightbox Modal Container -->
<div 
  id="lightbox-modal" 
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4 transition-opacity duration-300 opacity-0"
>
  <div class="relative max-w-4xl w-full max-h-[90vh] flex flex-col items-center justify-center">
    <!-- Tombol Close -->
    <button 
      id="lightbox-close" 
      class="absolute -top-10 right-0 text-white hover:text-gray-300 text-3xl font-bold focus:outline-none cursor-pointer"
      aria-label="Tutup foto"
    >
      &times;
    </button>
    
    <!-- Tag Gambar Modal -->
    <img 
      id="lightbox-img" 
      src="" 
      alt="" 
      class="max-h-[75vh] w-auto max-w-full rounded-lg object-contain shadow-2xl" 
    />
    
    <!-- Keterangan Foto -->
    <p 
      id="lightbox-caption" 
      class="text-white text-center mt-4 text-base md:text-lg font-medium px-4"
    ></p>
  </div>
</div>

<script>
  function setupLightbox() {
    const items = document.querySelectorAll('.galeri-item');
    const modal = document.getElementById('lightbox-modal');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const modalCaption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');

    if (!modal || !modalImg || !modalCaption || !closeBtn) return;

    const openModal = (src: string, title: string) => {
      modalImg.src = src;
      modalImg.alt = title;
      modalCaption.textContent = title;
      
      modal.classList.remove('hidden', 'opacity-0');
      modal.classList.add('flex', 'opacity-100');
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0');
      
      setTimeout(() => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        modalImg.src = '';
        document.body.style.overflow = '';
      }, 300);
    };

    items.forEach((item) => {
      item.addEventListener('click', () => {
        const src = item.getAttribute('data-src') || '';
        const title = item.getAttribute('data-title') || '';
        openModal(src, title);
      });
    });

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>