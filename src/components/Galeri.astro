---
import { getCollection, type CollectionEntry } from 'astro:content';

const kumpulansFoto = await getCollection('galeri');

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const fotoTampil = limit ? kumpulansFoto.slice(0, limit) : kumpulansFoto;
---

<section id="galeri" class="relative w-full bg-[#050505] text-white px-4 sm:px-6 py-20 scroll-mt-20 overflow-hidden">
  <div class="max-w-7xl mx-auto relative z-10">
    
    <div class="text-center mb-14">
      <span class="text-indigo-400 font-medium tracking-widest uppercase text-xs sm:text-sm">Dokumentasi</span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mt-2 mb-3 uppercase">
        Galeri
      </h2>
      <p class="text-zinc-400 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Suasana di Pendopo Taman Sanggar Seni Kebo Iwa
      </p>
    </div>

    {fotoTampil.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {fotoTampil.map((item: CollectionEntry<'galeri'>) => (
          <div 
            class="galeri-item group relative cursor-pointer overflow-hidden rounded-2xl bg-zinc-900/40 border border-white/10 hover:border-indigo-500/50 hover:shadow-[0_0_25px_rgba(99,102,241,0.2)] transition-all duration-300"
            data-src={item.data.image}
            data-title={item.data.title}
          >
            <div class="aspect-video w-full overflow-hidden bg-zinc-800 relative">
              <img
                src={item.data.image}
                alt={item.data.title}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-linear-to-t from-zinc-950/80 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity duration-300"></div>
            </div>

            <div class="p-4 bg-zinc-900/90 border-t border-white/5">
              <h3 class="font-semibold text-zinc-200 group-hover:text-white transition-colors duration-200 line-clamp-2 text-sm sm:text-base">
                {item.data.title}
              </h3>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-12 text-zinc-500 bg-zinc-900/30 rounded-2xl border border-white/5">
        Belum ada dokumentasi foto di galeri.
      </div>
    )}

  </div>

  <div class="absolute inset-0 z-0 pointer-events-none">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-150 h-150 bg-indigo-900/10 rounded-full blur-[140px]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-size-[4rem_4rem] mask-[radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)]"></div>
  </div>
</section>

<!-- Lightbox Modal Container -->
<div 
  id="lightbox-modal" 
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 backdrop-blur-md p-4 transition-all duration-300 opacity-0 pointer-events-none"
>
  <!-- Modal Content Box dengan Animasi Scale -->
  <div 
    id="lightbox-box" 
    class="relative max-w-4xl w-full max-h-[90vh] flex flex-col items-center justify-center bg-zinc-900/90 p-4 sm:p-6 rounded-3xl border border-white/10 shadow-2xl transition-all duration-300 scale-95 opacity-0"
  >
    <button 
      id="lightbox-close" 
      class="absolute top-4 right-4 text-zinc-400 hover:text-white bg-white/10 hover:bg-white/20 w-10 h-10 rounded-full flex items-center justify-center text-2xl font-bold transition-all duration-200 focus:outline-none cursor-pointer z-10"
      aria-label="Tutup foto"
    >
      &times;
    </button>
    
    <img 
      id="lightbox-img" 
      src="" 
      alt="" 
      class="max-h-[70vh] w-auto max-w-full rounded-xl object-contain shadow-2xl border border-white/10 mt-6 sm:mt-0" 
    />
    
    <p 
      id="lightbox-caption" 
      class="text-zinc-200 text-center mt-4 text-sm sm:text-base font-medium px-4"
    ></p>
  </div>
</div>

<script>
  function setupLightbox() {
    const items = document.querySelectorAll('.galeri-item');
    const modal = document.getElementById('lightbox-modal');
    const box = document.getElementById('lightbox-box');
    const modalImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const modalCaption = document.getElementById('lightbox-caption');
    const closeBtn = document.getElementById('lightbox-close');

    if (!modal || !box || !modalImg || !modalCaption || !closeBtn) return;

    const openModal = (src: string, title: string) => {
      modalImg.src = src;
      modalImg.alt = title;
      modalCaption.textContent = title;
      
      // 1. Tampilkan display flex dulu
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      
      // 2. Gunakan requestAnimationFrame agar browser me-render perubahan kelas secara soft
      requestAnimationFrame(() => {
        // Modal background fade in
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100');

        // Modal content box zoom in halus (scale-95 ke scale-100)
        box.classList.remove('scale-95', 'opacity-0');
        box.classList.add('scale-100', 'opacity-100');
      });

      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      // 1. Trigger animasi zoom out & fade out bersamaan
      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0', 'pointer-events-none');

      box.classList.remove('scale-100', 'opacity-100');
      box.classList.add('scale-95', 'opacity-0');
      
      // 2. Sembunyikan elemen setelah durasi animasi (300ms) selesai
      setTimeout(() => {
        modal.classList.remove('flex');
        modal.classList.add('hidden');
        modalImg.src = '';
        document.body.style.overflow = '';
      }, 300);
    };

    items.forEach((item) => {
      item.addEventListener('click', () => {
        const src = item.getAttribute('data-src') || '';
        const title = item.getAttribute('data-title') || '';
        openModal(src, title);
      });
    });

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  }

  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>