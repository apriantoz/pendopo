---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Tentang from '../components/Tentang.astro';
import SewaTempat from '../components/SewaTempat.astro';
import SewaLokal from '../components/SewaLokal.astro';
import SewaAsing from '../components/SewaAsing.astro';
import PaketPrewedding from '../components/PaketPrewedding.astro';
import PaketWedding from '../components/PaketWedding.astro';
import PaketTambahan from '../components/PaketTambahan.astro';
import PaketUltah from '../components/PaketUltah.astro';
import FotoPerorangan from '../components/FotoPerorangan.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import HubungiKami from '../components/HubungiKami.astro';
---

<Layout title="Pendopo Taman SSKI - Ruang Terbuka Seni & Budaya Bali" description="Pendopo Taman SSKI adalah ruang terbuka yang menggabungkan keindahan seni dan budaya Bali. Kami menyediakan berbagai program workshop seni, pelatihan sanggar tari dan gamelan, serta penyediaan tempat untuk berbagai momentum istimewa.">
  <Navbar/>
  <main class="bg-[#050505] text-white selection:bg-indigo-500 selection:text-white overflow-x-hidden">
    <Hero/>
    <Tentang/>
    <SewaTempat/>
    <SewaLokal/>
    <SewaAsing/>
    <PaketUltah/>
    <FotoPerorangan/>
    <PaketPrewedding/>
    <PaketWedding/>
    <PaketTambahan/>
    <HubungiKami/>
</main>
  <Footer/>
</Layout>